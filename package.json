{
  "name": "smarttownship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests eslint.config.js vitest.config.ts playwright.config.ts",
    "test": "vitest run --configLoader native",
    "test:runtime": "node --test tests/runtime.test.mjs tests/api.test.mjs tests/hosted-config.test.mjs tests/pitch-config.test.mjs",
    "api": "node apps/api/server.mjs",
    "test:integration": "node scripts/test-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "demo:configure": "node scripts/configure-demo.mjs",
    "demo:pitch": "node scripts/seed-pitch.mjs",
    "simulate:dispatch": "node scripts/simulate-dispatch.mjs",
    "build:web": "vite build apps/web",
    "build:api": "node scripts/build-api.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:services": "node scripts/verify-supabase.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:db:local": "supabase test db",
    "test:e2e": "node scripts/run-browser.mjs hosted",
    "test:e2e:setup": "node scripts/browser-setup.mjs",
    "preview": "vite preview apps/web --host 127.0.0.1 --port 5174 --strictPort",
    "test:e2e:contract": "node scripts/run-browser.mjs contract"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.64.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "pg": "8.23.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
